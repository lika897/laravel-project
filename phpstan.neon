includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:

    paths:
        - app/
        - database/migrations/
        - database/seeders/

    # Level 10 is the highest level
    level: 5

#    ignoreErrors:
#        - '#PHPDoc tag @var#'

    excludePaths:
        - ./vendor
        - ./app/Http/Resources
